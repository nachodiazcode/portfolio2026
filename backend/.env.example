# Base de datos (PostgreSQL). En local puedes usar Docker o un Postgres gestionado.
DATABASE_URL="postgresql://usuario:clave@localhost:5432/portfolio?schema=public"

# Secretos JWT — genera valores largos y únicos:  openssl rand -base64 48
JWT_ACCESS_SECRET="cambia-esto-por-un-secreto-largo"
JWT_REFRESH_SECRET="cambia-esto-por-otro-secreto-distinto"

# Orígenes permitidos (separados por coma)
CORS_ORIGINS="http://localhost:4200,https://nachodiazcode.github.io"

# Correo del dueño del portafolio: ese usuario recibe rol ADMIN al registrarse
OWNER_EMAIL="ignaciosergiodiaz@gmail.com"

PORT=3000
